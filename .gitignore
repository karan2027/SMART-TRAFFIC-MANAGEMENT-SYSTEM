# Archives & large zips
*.zip
*.tar.gz
*.rar

# Node dependencies & build artifacts
node_modules/
dist/
build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python dependencies & virtual environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/
.pytest_cache/

# AI Models & weights downloaded at runtime (except config)
*.pt
*.onnx
*.engine

# Video & Large output files
data/videos/*.mp4
data/videos/*.avi
data/videos/*.mov
data/outputs/*.mp4
data/outputs/*.avi
!data/videos/.gitkeep
!data/outputs/.gitkeep

# Environment files & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE & System files
.vscode/
.idea/
.DS_Store
Thumbs.db
